<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ChessersEngine golden-master ORACLE (Phase 0 of the Rust port).
    Drives every TestScenarios fixture through the engine and emits canonical,
    id-sorted JSON that the Rust rewrite must reproduce byte-for-byte.
    See oracle/README.md for how to run it and what it emits.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- stable, culture-independent number/string formatting in the golden files -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ChessersOracle</RootNamespace>
    <AssemblyName>ChessersOracle</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessersEngine.csproj" />
  </ItemGroup>

</Project>
