<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The engine sources live at the repo root, so default globbing would
         otherwise pull the sibling test project's sources into this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ChessersEngine.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.2.2" />
  </ItemGroup>

</Project>
