<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The engine sources live at the repo root, so default globbing would
         otherwise pull the sibling test/CLI/oracle projects' sources (and their
         generated obj/ files) into this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ChessersEngine.Tests/**;ChessersEngine.Cli/**;oracle/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.2.2" />
  </ItemGroup>

</Project>
