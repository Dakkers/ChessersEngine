<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChessersEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bench sources compiled in directly: a ProjectReference to ChessersEngine.Bench would
         duplicate every engine type. WorkloadRegistry.cs needs the engine types, which the
         ProjectReference above already supplies. -->
    <Compile Include="..\ChessersEngine.Bench\Stats.cs" />
    <Compile Include="..\ChessersEngine.Bench\Workloads.cs" />
    <Compile Include="..\ChessersEngine.Bench\WorkloadRegistry.cs" />
    <Content Include="..\ChessersEngine.Bench\workloads.v1.json" CopyToOutputDirectory="PreserveNewest" Link="workloads.v1.json" />
    <Content Include="..\ChessersEngine.Bench\replay-sequence.v1.json" CopyToOutputDirectory="PreserveNewest" Link="replay-sequence.v1.json" />
  </ItemGroup>

</Project>
