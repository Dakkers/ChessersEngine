{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Dakkers/ChessersEngine/master/ChessersEngine.Cli/schemas/oracle.v1.schema.json",
  "title": "Chessers oracle game (v1)",
  "description": "A single recorded Chessers game emitted by ChessersEngine.Cli: the initial board, every move attempt with its full engine MoveResult, and a board snapshot after each turn. Replayable for differential testing of a port. The format version lives in the `$schema` URI (this is v1); released versions are kept immutably under ChessersEngine.Cli/schemas/.",
  "type": "object",
  "required": ["$schema", "schemaVersion", "engine", "config", "initialPieces", "plies", "outcome"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/Dakkers/ChessersEngine/master/ChessersEngine.Cli/schemas/oracle.v1.schema.json",
      "description": "Identifies the format version; v1 pins to this exact schema file."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Machine-readable format version; must equal the vN in $schema (a CI check enforces this)."
    },
    "engine": { "type": "string", "description": "Identifier of the engine that produced this file." },
    "config": { "$ref": "#/$defs/config" },
    "initialPieces": {
      "type": "array",
      "description": "The starting board, before any move.",
      "items": { "$ref": "#/$defs/chessmanSchema" }
    },
    "plies": {
      "type": "array",
      "description": "One entry per turn, in order.",
      "items": { "$ref": "#/$defs/ply" }
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "rejectedAttempts": {
      "type": "array",
      "description": "Moves the engine rejected during play (illegal moves). Empty for AI-only games, whose search only ever produces legal moves.",
      "items": { "$ref": "#/$defs/rejectedAttempt" }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "enum": ["WHITE", "BLACK"]
    },
    "chessmanKind": {
      "type": "string",
      "enum": ["PAWN", "KNIGHT", "BISHOP", "ROOK", "QUEEN", "KING"]
    },
    "playerKind": {
      "type": "string",
      "enum": ["human", "ai"]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["white", "black", "aiLevel", "randomSeed", "deathjumpSetting", "whitePlayerId", "blackPlayerId"],
      "properties": {
        "white": { "$ref": "#/$defs/playerKind" },
        "black": { "$ref": "#/$defs/playerKind" },
        "aiLevel": { "type": "integer" },
        "randomSeed": {
          "type": ["integer", "null"],
          "description": "Seed for the move-search RNG; null means a time-seeded (non-reproducible) run."
        },
        "deathjumpSetting": {
          "type": "string",
          "enum": ["OFF", "SIDES", "BACK", "ALL"]
        },
        "whitePlayerId": { "type": "integer" },
        "blackPlayerId": { "type": "integer" },
        "scenario": {
          "type": ["string", "null"],
          "description": "Name of the TestScenarios fixture this game was seeded from (--scenario); absent for games from the standard opening."
        }
      }
    },
    "chessmanSchema": {
      "type": "object",
      "description": "A piece's full state. tile ids/locations range from -36..63.",
      "additionalProperties": false,
      "required": ["colorId", "guid", "hasMoved", "id", "isActive", "isChecker", "isKinged", "isPromoted", "kind", "location"],
      "properties": {
        "colorId": { "type": "integer", "description": "0 = WHITE, 1 = BLACK." },
        "guid": { "type": "integer" },
        "hasMoved": { "type": "boolean" },
        "id": { "type": "integer", "description": "0..31; stable per-piece identifier." },
        "isActive": { "type": "boolean", "description": "false once captured or jumped off." },
        "isChecker": { "type": "boolean", "description": "true when the piece is currently in checker (polarity) form." },
        "isKinged": { "type": "boolean" },
        "isPromoted": { "type": "boolean" },
        "kind": { "type": "integer", "minimum": 0, "maximum": 5, "description": "CHESSMAN_KIND_*: 0 PAWN, 1 KNIGHT, 2 BISHOP, 3 ROOK, 4 QUEEN, 5 KING." },
        "location": { "type": "integer", "description": "Tile id the piece occupies (or last occupied if inactive)." }
      }
    },
    "moveAttempt": {
      "type": "object",
      "description": "The input handed to Match.MoveChessman for one (sub-)move.",
      "additionalProperties": false,
      "required": ["pieceGuid", "pieceId", "playerId", "promotionRank", "tileId"],
      "properties": {
        "pieceGuid": { "type": "integer" },
        "pieceId": { "type": "integer" },
        "playerId": { "type": "integer" },
        "promotionRank": { "type": "integer", "description": "Target ChessmanKind index for a promotion, or -1 for none." },
        "tileId": { "type": "integer" }
      }
    },
    "moveResult": {
      "type": "object",
      "description": "The engine's full output for one (sub-)move.",
      "additionalProperties": false,
      "required": [
        "playerId", "pieceId", "pieceGuid", "fromTileId", "tileId", "turnChanged", "type",
        "polarityChanged", "wasFirstMoveForPiece", "kinged", "isCastle", "promotionOccurred",
        "promotionRank", "wasPieceJumped", "jumpedPieceId", "jumpedTileId", "wasPieceCaptured",
        "capturedPieceId", "isWinningMove", "isInCheck", "isStalemate", "valid", "notation",
        "fromRow", "toRow", "fromColumn", "toColumn", "chessmanKind"
      ],
      "properties": {
        "playerId": { "type": "integer" },
        "pieceId": { "type": "integer" },
        "pieceGuid": { "type": "integer" },
        "fromTileId": { "type": "integer" },
        "tileId": { "type": "integer" },
        "turnChanged": { "type": "boolean", "description": "false when a checker jump leaves a legal continuation (the same piece must move again)." },
        "type": { "type": "integer", "description": "MOVE_TYPE_*: 0 REGULAR, 1 JUMP, 2 TAKE, 3 CASTLING." },
        "polarityChanged": { "type": "boolean" },
        "wasFirstMoveForPiece": { "type": "boolean" },
        "kinged": { "type": "boolean" },
        "isCastle": { "type": "boolean" },
        "promotionOccurred": { "type": "boolean" },
        "promotionRank": {
          "oneOf": [{ "$ref": "#/$defs/chessmanKind" }, { "type": "null" }],
          "description": "The rank promoted to (by name), or null."
        },
        "wasPieceJumped": { "type": "boolean" },
        "jumpedPieceId": { "type": "integer", "description": "-1 when no piece was jumped." },
        "jumpedTileId": { "type": "integer", "description": "-1 when no piece was jumped." },
        "wasPieceCaptured": { "type": "boolean" },
        "capturedPieceId": { "type": "integer", "description": "-1 when no piece was captured." },
        "isWinningMove": { "type": "boolean" },
        "isInCheck": { "type": "boolean" },
        "isStalemate": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "notation": { "type": ["string", "null"] },
        "fromRow": { "type": "integer" },
        "toRow": { "type": "integer" },
        "fromColumn": { "type": "integer" },
        "toColumn": { "type": "integer" },
        "chessmanKind": {
          "$ref": "#/$defs/chessmanKind",
          "description": "The kind the piece STARTED the move as (a promoting pawn is PAWN here; promotionRank holds the new rank)."
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "notation", "result"],
      "properties": {
        "attempt": { "$ref": "#/$defs/moveAttempt" },
        "notation": { "type": "string" },
        "result": { "$ref": "#/$defs/moveResult" }
      }
    },
    "ply": {
      "type": "object",
      "description": "One full turn. `moves` has more than one entry only for a multi-jump turn.",
      "additionalProperties": false,
      "required": ["index", "turnColor", "playerId", "actor", "moves", "committedNotation", "boardAfter"],
      "properties": {
        "index": { "type": "integer", "description": "1-based turn number." },
        "turnColor": { "$ref": "#/$defs/color" },
        "playerId": { "type": "integer" },
        "actor": { "$ref": "#/$defs/playerKind" },
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/move" }
        },
        "committedNotation": {
          "type": ["string", "null"],
          "description": "Comma-joined notation for the turn (Match.GetLastMove())."
        },
        "boardAfter": {
          "type": "array",
          "items": { "$ref": "#/$defs/chessmanSchema" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameOver", "winningPlayerId", "winningColor", "isDraw", "isResignation", "reason"],
      "properties": {
        "gameOver": { "type": "boolean" },
        "winningPlayerId": { "type": "integer", "description": "-1 when there is no winner." },
        "winningColor": {
          "oneOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }]
        },
        "isDraw": { "type": "boolean" },
        "isResignation": { "type": "boolean" },
        "reason": {
          "type": "string",
          "enum": ["checkmate", "stalemate", "resignation", "move-limit", "no-legal-moves", "quit", "in-progress"]
        }
      }
    },
    "rejectedAttempt": {
      "type": "object",
      "description": "An attempt the engine rejected. Replay: load `board`, call MoveChessman(attempt), and assert the same rejection -- a null `result` means the engine returned null (e.g. the target holds the player's own piece); otherwise `result.valid` is false. The other fields of an invalid result are incidental.",
      "additionalProperties": false,
      "required": ["turnColor", "playerId", "attempt", "result", "board"],
      "properties": {
        "turnColor": { "$ref": "#/$defs/color" },
        "playerId": { "type": "integer" },
        "attempt": { "$ref": "#/$defs/moveAttempt" },
        "result": {
          "oneOf": [{ "$ref": "#/$defs/moveResult" }, { "type": "null" }]
        },
        "board": {
          "type": "array",
          "description": "The position the move was attempted against (unchanged by the rejected attempt).",
          "items": { "$ref": "#/$defs/chessmanSchema" }
        }
      }
    }
  }
}
