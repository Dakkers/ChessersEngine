{
  "name": "chessers-schema-check",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript + Zod validators for the Chessers oracle/codec golden-corpus JSON.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=26.1.0"
  },
  "scripts": {
    "check:oracle": "node check-oracle.ts",
    "check:codec": "node check-codec.ts",
    "check:perf": "node check-perf.ts",
    "check:workloads": "node check-workloads.ts",
    "compare:perf": "node compare-perf.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt *.ts",
    "fmt:check": "oxfmt --check *.ts",
    "lint": "oxlint --fix",
    "lint:check": "oxlint"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "6.0.3"
  }
}
